    "Activity will show up here when you add purifiers or replace filters.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động sẽ xuất hiện ở đây khi bạn thêm máy lọc hoặc thay lõi lọc."
          }
        }
      }
    },
    "Add GoogleService-Info.plist to the app target. See ios/README.md.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm GoogleService-Info.plist vào app target. Xem ios/README.md."
