{
  "sourceLanguage": "en",
  "strings": {
    "%@ (you)": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (bạn)"
          }
        }
      }
    },
    "%@ in %@ is due in %lld days.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ của %2$@ sẽ đến hạn thay sau %3$lld ngày."
          }
        }
      }
    },
    "%@ in %@ is due today.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ của %2$@ đến hạn thay hôm nay."
          }
        }
      }
    },
    "%@ invited you to \"%@\" as %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mời bạn vào \"%2$@\" với quyền %3$@"
          }
        }
      }
    },
    "%@ · Expires %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Hết hạn %2$@"
          }
        }
      }
    },
    "%@. With an email, only that person can use the invite. Without one, anyone with the link can. Invites expire after 7 days.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Nếu nhập email, chỉ người đó dùng được lời mời; nếu không, ai có link cũng dùng được. Lời mời hết hạn sau 7 ngày."
          }
        }
      }
    },
    "%lld days left": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn %lld ngày"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld day left"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld days left"
                }
              }
            }
          }
        }
      }
    },
    "Accept": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chấp nhận"
          }
        }
      }
    },
